# Server-only secrets — never expose to the browser / Studio

# Gemini (Google AI Studio / Gemini API)
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Cloudflare Workers AI (FLUX.2 Klein)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Kokoro local TTS (OpenAI-compatible FastAPI)
# Test reachability from the API process before generating narration.
KOKORO_BASE_URL=http://localhost:8880
KOKORO_API_KEY=

# API server
# 8787 is reserved by a local MCP authentication proxy on the development machine.
PORT=8788
HOST=0.0.0.0

# Project storage (relative to repo root unless absolute)
PROJECTS_DIR=./projects

# Optional: absolute path to story-video-engine (Remotion workspace).
# Only needed if auto-detection fails. Example:
# STORY_VIDEO_ENGINE_DIR=C:\video generator\story-video-engine

# Prefer PROJECTS_DIR at monorepo root (not under apps/api):
# PROJECTS_DIR=./projects

# Remotion export memory (Windows multi-scene 1080x1920 often needs >2GB)
# REMOTION_MAX_OLD_SPACE_SIZE=8192
# REMOTION_CONCURRENCY=1
